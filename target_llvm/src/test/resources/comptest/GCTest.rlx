pkg comptest;

use ralux.debug.Debug;
use tfc.ralux.runtime.GC;

public class GCTest {
    public static int main() {
        GC gc = GC.getGlobalGC();
        //for (int i = 0; i < 1000000; i++) {
        for (int i = 0; i < 32000; i++) {
            GCTest o0 = new GCTest();
            GCTest o1 = new GCTest();
            int hc = o0.#;
            Debug.write(i);
            Debug.write(hc);
            // Debug.write(i);
            o0 = null;
            o1 = null;
            // GC.collect(gc);
        }
        GC.collect(gc);
        Debug.write(100);
        for (int i1 = 0; i1 < 32; i1++) {
            Debug.write(0);
        }
        return 0;
    }
}
