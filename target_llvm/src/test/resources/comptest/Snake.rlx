pkg comptest;

use ralux.debug.Debug;

public class Snake {
    public static int main() {
        byte[] string = new byte[14];
        string[0] = 'I';
        string[1] = 'n';
        string[2] = 'p';
        string[3] = 'u';
        string[4] = 't';
        string[5] = ' ';
        string[6] = 'S';
        string[7] = 'i';
        string[8] = 'z';
        string[9] = 'e';
        string[10] = '\n';
        string[11] = '>';
        string[12] = ' ';
        string[13] = 0b;
        Debug.write(string);
        string = null;

        byte[] failStr = new byte[6];
        failStr[0] = 'D';
        failStr[1] = 'e';
        failStr[2] = 'a';
        failStr[3] = 'd';
        failStr[4] = '.';
        failStr[5] = 0b;

        int boardSize = Debug.readInt32();

        byte[] data = new byte[boardSize * boardSize];

        byte w = (byte) 'w';
        byte a = (byte) 'a';
        byte s = (byte) 's';
        byte d = (byte) 'd';
        byte NL = (byte) '\n';

        int headX = boardSize / 2;
        int headY = boardSize / 2;

        byte[] raster = new byte[boardSize + 1];

        int tailX = boardSize / 2;
        int tailY = boardSize / 2;

        int appleX = Debug.random(0, boardSize);
        int appleY = Debug.random(0, boardSize);

        byte grow = 1b;

        byte omX = 0b;
        byte omY = 0b;

        while (true) {
            byte dir = (byte) Debug.readChar();
            if (dir == NL) {
                continue;
            }

            byte mX = calcDir(dir, d, a);
            byte mY = calcDir(dir, s, w);
            if (
                (mX == mY) ||
                    (omX != 0b && omX == -mX) ||
                    (omY != 0b && omY == -mY)
            ) {
                continue;
            }

            data[headY * boardSize + headX] = dir;

            headX += mX;
            headY += mY;

            if (headX < 0 || headX >= boardSize) {
                headX -= mX;
                continue;
            }
            if (headY < 0 || headY >= boardSize) {
                headY -= mY;
                continue;
            }

            omX = mX;
            omY = mY;

            if (headX == appleX && headY == appleY) {
                appleX = Debug.random(0, boardSize);
                appleY = Debug.random(0, boardSize);
                grow += 1;
            }

            if (grow >= 0) {
                grow--;
            } else {
                dir = data[tailY * boardSize + tailX];
                data[tailY * boardSize + tailX] = 0;

                mX = calcDir(dir, d, a);
                mY = calcDir(dir, s, w);

                tailX += mX;
                tailY += mY;
            }

            byte occupied = data[headY * boardSize + headX];
            boolean dead = occupied != 0b;

            for (int y = 0; y < boardSize; y++) {
                for (int x = 0; x < boardSize; x++) {
                    int index = y * boardSize + x;
                    byte value = data[index];
                    if (x == headX && y == headY) {
                        if (dead) {
                            raster[x] = 'X';
                        } else {
                            raster[x] = 'O';
                        }
                    } else if (x == appleX && y == appleY) {
                        raster[x] = 'a';
                    } else if (value != 0) {
                        raster[x] = 'o';
                    } else {
                        raster[x] = '.';
                    }
                }
                Debug.write(raster);
            }

            if (dead) {
                Debug.write(failStr);
                break;
            }
        }

        return 0;
    }

    public static byte calcDir(byte input, byte refU, byte refD) {
        if (input == refU) {
            return 1b;
        } else if (input == refD) {
            return -1b;
        }
        return 0b;
    }
}
